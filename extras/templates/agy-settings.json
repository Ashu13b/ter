      "command(grep)",
      "command(strace)",
      "command(sed)",
      "command(git diff)",
      "command(pytest)",
      "command(netstat)",
      "command(git checkout)",
      "command(git merge)",
      "command(git add)",
      "command(git log)",
      "command(git show)",
      "command(termux-fix-shebang)",
      "command(awk)"
