{
    "name": "TER",
    "version": "1.5",
    "description": "Termux Custom Environment",
    "command_groups": {
        "SYSTEM": ["re", "up", "cls", "ter (info|doctor|update|sync|snapshot|wizard|theme|shortcut|perms|account)"],
        "NAV": ["..", "...", "cd (ws|dl)", "path"],
        "NETWORK": ["scan (net|sniff)", "adbcon", "dvop (on|off|toggle|status)"],
        "ADB": ["adb-sysinfo", "adb-audit", "adb-manage", "adb-apk", "adb-logcat", "adb-screengrab"],
        "STABILITY": ["optimize (status|fix|run|list|log)"],
        "REGISTRY": ["apps list", "alm (alias manager)", "tabname"],
        "AI / AUTH": ["agy-account (list|switch|next|save|sync)", "airlink (web|qr|open)", "qr", "url-heal", "auth-code", "codext"]
    }
}
